---
import '../../styles/global.css';
---
<!doctype html><html lang="it"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><title>CMS — Area Staff</title><link rel="icon" href="/favicon-48.png"/></head><body class="cms-body">
<header class="cms-top"><a href="/staff/">← Area Staff</a><strong>Retro di testa · CMS</strong><div><span data-user></span><button class="button" data-logout>Esci</button></div></header>
<main class="cms-shell">
  <aside class="cms-nav"><button class="active" data-view-button="editor">＋ Nuovo contenuto</button><button data-view-button="library">Articoli e bozze</button><button data-view-button="trash">Cestino</button><a href="/staff/#security">Sicurezza</a><a href="/staff/cms-guida/">Guida completa</a></aside>
  <section class="cms-main">
    <div data-view="editor">
      <div class="cms-heading"><div><p class="eyebrow">CMS SEMPLIFICATO</p><h1 data-editor-title>Nuovo contenuto</h1></div><p class="cms-saved" data-save-status>Bozza non ancora salvata</p></div>
      <div class="cms-grid"><form class="cms-card cms-editor" data-editor-form>
        <input type="hidden" name="id"/>
        <div class="cms-tabs"><button type="button" class="active" data-tab="write">Scrivi</button><button type="button" data-tab="import">Importa file</button><button type="button" data-tab="google">Google</button><button type="button" data-tab="options">Opzioni</button></div>
        <div data-pane="write"><div class="cms-fields"><label class="wide">Titolo<input name="title" required maxlength="180" placeholder="Titolo chiaro del contenuto"/></label><label>Tipo<select name="kind"><option value="articolo">Articolo</option><option value="guida">Guida</option><option value="recensione">Recensione</option></select></label><label>Categoria<select name="category"><option value="guide">Guide</option><option value="soluzioni">Soluzioni</option><option value="test">Test</option><option value="recensioni">Recensioni</option></select></label><label class="wide">Descrizione breve<textarea name="description" required maxlength="320" rows="3"></textarea></label><label class="wide">Testo dell’articolo<textarea name="body" rows="22" placeholder="Scrivi qui. Usa ## per un titolo e **testo** per il grassetto."></textarea></label></div></div>
        <div data-pane="import" hidden><label class="cms-drop">Importa Word, PDF, Markdown, HTML, testo o ZIP<input data-import-file type="file" accept=".docx,.pdf,.md,.html,.htm,.txt,.zip"/></label><p class="muted"><strong>HTML:</strong> mantiene impaginazione, colori, forme e immagini sicure. Se le immagini sono file separati, inserisci HTML e immagini nello stesso ZIP: il CMS le caricherà e collegherà automaticamente.</p><p data-import-status role="status"></p></div>
        <div data-pane="google" hidden><div class="cms-fields"><label class="wide">Indirizzo della pagina<input name="slug" required pattern="[a-z0-9-]+"/></label></div><p class="muted">Google userà il titolo e la descrizione breve inseriti nella prima scheda. Sitemap e pagina vengono aggiornate soltanto quando confermi la pubblicazione.</p></div>
        <div data-pane="options" hidden><div class="cms-fields"><label class="wide">Parole chiave, separate da virgole<input name="tags"/></label><label class="wide">Carica la foto principale<input data-image-file type="file" accept="image/jpeg,image/png,image/webp,image/gif"/><small>JPG, PNG, WebP o GIF, massimo 5 MB.</small></label><label class="wide">Foto scelta<input name="image" readonly placeholder="La foto caricata apparirà qui"/></label><label class="wide">Descrizione della foto<input name="imageAlt" placeholder="Descrivi ciò che si vede per chi usa un lettore vocale"/></label></div><p data-image-status role="status"></p></div>
        <div class="cms-actions"><button class="button" type="button" data-reset-editor>Annulla</button><button class="button dark" type="submit">Salva bozza</button></div><p data-editor-status role="status"></p>
      </form><aside class="cms-side"><article class="cms-card"><h2>Stato</h2><p><span class="cms-state draft" data-current-state>Bozza privata</span></p><p class="muted">Nessuno vede il contenuto finché non scegli Pubblica e riconfermi la tua identità.</p><button class="button" type="button" data-preview>Anteprima</button><button class="button publish" type="button" data-publish disabled>Pubblica…</button></article><article class="cms-card"><h2>Controllo</h2><ul class="cms-checks"><li data-check="title">Titolo</li><li data-check="description">Descrizione</li><li data-check="body">Testo</li><li data-check="slug">Indirizzo</li></ul></article></aside></div>
    </div>
    <div data-view="library" hidden><div class="cms-heading"><div><p class="eyebrow">ARCHIVIO</p><h1>Articoli e bozze</h1></div><button class="button dark" data-new>＋ Nuovo</button></div><div class="cms-list" data-content-list></div></div>
    <div data-view="trash" hidden><div class="cms-heading"><div><p class="eyebrow">RECUPERO</p><h1>Cestino</h1></div></div><p class="cms-note">Puoi ripristinare un contenuto oppure eliminarlo definitivamente. L’eliminazione definitiva non richiede un backup e non può essere annullata.</p><div class="cms-list" data-trash-list></div></div>
  </section>
</main>
<dialog data-reauth><form data-reauth-form><h2>Conferma che sei tu</h2><p>Pubblicare, nascondere o cestinare richiede nuovamente password e secondo fattore.</p><label>Password<input name="password" type="password" required/></label><label>Codice a 6 cifre oppure codice di recupero<input name="totp" maxlength="20"/></label><p data-reauth-status></p><div class="cms-actions"><button class="button" type="button" data-close-reauth>Annulla</button><button class="button dark">Conferma</button></div></form></dialog>
<dialog class="preview-dialog" data-preview-dialog><div class="preview-toolbar"><strong>Anteprima privata</strong><div><button class="button active" data-preview-mode="cosmo">Cosmo</button><button class="button" data-preview-mode="retro">Retro 95–99</button><button class="button" data-close-preview>Chiudi</button></div></div><article data-preview-page><p class="preview-eyebrow" data-preview-category></p><h1 data-preview-title></h1><p class="preview-lead" data-preview-description></p><figure data-preview-figure hidden><img data-preview-image alt=""/></figure><div class="preview-copy" data-preview-body></div></article></dialog>
<dialog data-confirm><h2 data-confirm-title>Conferma</h2><p data-confirm-text></p><div class="cms-actions"><button class="button" data-confirm-cancel>Annulla</button><button class="button publish" data-confirm-ok>Continua</button></div></dialog>
<style>
:root{--deep:#07111f;--panel:#12233a;--panel2:#0b1729;--line:#38506d;--ink:#f4f7fb;--muted:#a9bad0;--cyan:#69dff2;--red:#ff554e;--green:#42d990}*{box-sizing:border-box}.cms-body{margin:0;min-height:100vh;color:var(--ink);background:radial-gradient(circle at 15% 20%,#fff 0 1px,transparent 2px),radial-gradient(circle at 70% 65%,#69dff2 0 1px,transparent 2px),linear-gradient(145deg,#07101d,#112a4b);background-size:230px 230px,330px 330px,auto;font:16px/1.5 system-ui,sans-serif}.cms-top{height:74px;padding:0 24px;display:flex;align-items:center;justify-content:space-between;gap:20px;background:#081525ee;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:5}.cms-top a{color:var(--cyan)}.cms-top div{display:flex;align-items:center;gap:10px}.cms-shell{display:grid;grid-template-columns:230px minmax(0,1fr);max-width:1500px;margin:auto;min-height:calc(100vh - 74px)}.cms-nav{padding:24px 14px;border-right:1px solid var(--line);background:#081525cc}.cms-nav button,.cms-nav a{display:block;width:100%;padding:13px;border:0;border-radius:10px;background:transparent;color:#bed0e4;text-align:left;text-decoration:none;margin-bottom:5px}.cms-nav .active{background:#193653;color:#fff;box-shadow:inset 4px 0 var(--cyan)}.cms-main{padding:30px;min-width:0}.cms-heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:22px}.cms-heading h1{font-size:40px;margin:0}.cms-saved{color:var(--muted)}.cms-grid{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:18px}.cms-card{background:linear-gradient(150deg,#13243cf2,#0e1a2df2);border:1px solid var(--line);border-radius:17px;padding:20px}.cms-tabs{display:flex;gap:5px;border-bottom:1px solid var(--line);margin-bottom:20px;overflow:auto}.cms-tabs button{padding:11px 14px;border:0;border-bottom:3px solid transparent;background:transparent;color:var(--muted);font-weight:800}.cms-tabs .active{border-color:var(--cyan);color:white}.cms-fields{display:grid;grid-template-columns:1fr 1fr;gap:14px}.cms-fields label,.cms-editor label,.cms-body dialog label{display:grid;gap:6px;font-weight:800;font-size:13px}.cms-fields .wide{grid-column:1/-1}.cms-fields input,.cms-fields textarea,.cms-fields select,.cms-body dialog input{width:100%;padding:12px;border:1px solid #3b5471;border-radius:10px;background:#071525;color:white;font:inherit}.cms-actions{display:flex;justify-content:flex-end;gap:9px;margin-top:18px}.button{padding:10px 14px;border:1px solid #45617f;border-radius:10px;background:#142942;color:white;font-weight:800}.button.dark{background:#183b58}.button.publish{background:var(--green);border-color:var(--green);color:#06150e;width:100%;margin-top:9px}.button:disabled{opacity:.45}.cms-drop{min-height:230px;border:2px dashed #4a6a8b;border-radius:15px;display:grid!important;place-items:center;padding:28px;text-align:center;background:#081729}.cms-drop input{display:block;margin-top:14px;max-width:100%}.cms-side{display:grid;gap:14px;align-content:start}.cms-state{display:inline-block;padding:6px 10px;border-radius:999px;font-size:12px;font-weight:900}.cms-state.draft{background:#4a3715;color:#ffe198}.cms-state.published{background:#143f32;color:#78e6b1}.cms-state.hidden{background:#39294c;color:#d9baff}.cms-checks{padding:0;list-style:none}.cms-checks li{padding:9px;border-bottom:1px solid #29405b;color:#ffbf7c}.cms-checks li.ok{color:#72e4aa}.cms-checks li:before{content:'○';margin-right:8px}.cms-checks li.ok:before{content:'✓'}.cms-list{display:grid;gap:10px}.cms-row{display:grid;grid-template-columns:1fr auto auto;gap:12px;align-items:center;padding:16px;border:1px solid var(--line);border-radius:13px;background:#0e1c30}.cms-row small{display:block;color:var(--muted)}.cms-row-actions{display:flex;gap:7px;flex-wrap:wrap}.cms-note{border-left:4px solid #ffd35a;background:#ffd35a14;padding:13px 15px}.cms-body dialog{max-width:500px;border:1px solid #4b6684;border-radius:17px;background:#12233a;color:white;padding:24px}.muted{color:var(--muted)}[hidden]{display:none!important}@media(max-width:1100px){.cms-shell{grid-template-columns:80px minmax(0,1fr)}.cms-nav button,.cms-nav a{font-size:0;text-align:center}.cms-nav button:before,.cms-nav a:before{content:'•';font-size:22px}.cms-grid{grid-template-columns:1fr}.cms-side{grid-template-columns:repeat(2,1fr)}}@media(max-width:700px){.cms-top span{display:none}.cms-shell{display:block}.cms-nav{display:flex;overflow:auto;border-right:0;border-bottom:1px solid var(--line);padding:8px}.cms-nav button,.cms-nav a{min-width:54px;margin:0}.cms-main{padding:20px 14px}.cms-heading{align-items:flex-start;flex-direction:column}.cms-heading h1{font-size:32px}.cms-fields{grid-template-columns:1fr}.cms-fields .wide{grid-column:auto}.cms-side{grid-template-columns:1fr}.cms-row{grid-template-columns:1fr}}
.preview-dialog{width:min(1100px,calc(100% - 24px));max-width:1100px!important;height:min(860px,calc(100% - 24px));padding:0!important;overflow:auto}.preview-dialog::backdrop{background:#020914dd}.preview-toolbar{position:sticky;top:0;z-index:2;display:flex;justify-content:space-between;align-items:center;gap:15px;padding:14px 18px;background:#071525;border-bottom:1px solid #3b5471}.preview-toolbar>div{display:flex;gap:7px;flex-wrap:wrap}.preview-toolbar .active{border-color:var(--cyan);box-shadow:inset 0 -3px var(--cyan)}[data-preview-page]{min-height:100%;padding:clamp(28px,6vw,72px);background:#0d2038;color:#f4f7fb}[data-preview-page].retro{font-family:Verdana,Arial,sans-serif;background-color:#b8c8dc;background-image:linear-gradient(#fff6 1px,transparent 1px),linear-gradient(90deg,#fff6 1px,transparent 1px);background-size:24px 24px;color:#071a36;border:8px ridge #d8e8fa}[data-preview-page] h1{max-width:850px;font-size:clamp(38px,7vw,76px);line-height:1;margin:.15em 0}.preview-eyebrow{font-weight:900;letter-spacing:.18em;color:#69dff2}[data-preview-page].retro .preview-eyebrow{color:#003fd1}.preview-lead{font-size:clamp(18px,2.4vw,27px);max-width:850px}.preview-copy{max-width:820px;font-size:18px;line-height:1.8}.preview-copy h2{font-size:32px;margin-top:1.6em}.preview-copy p{white-space:pre-wrap}.preview-dialog figure{margin:28px 0}.preview-dialog img{max-width:100%;max-height:480px;object-fit:contain}.cms-row-actions .button.publish{width:auto;margin-top:0}
</style>
<style>.button.danger{background:#b42318!important;border-color:#ff746b!important;color:#fff!important}.preview-copy .cms-rich{max-width:100%;overflow-wrap:anywhere}.preview-copy .cms-rich img,.preview-copy .cms-rich svg{max-width:100%;height:auto}.preview-copy .cms-rich table{display:block;overflow:auto;max-width:100%;border-collapse:collapse}</style>
<script>
import * as mammoth from 'mammoth/mammoth.browser';
import JSZip from 'jszip';
import * as pdfjs from 'pdfjs-dist/build/pdf.mjs';
pdfjs.GlobalWorkerOptions.workerSrc = new URL('pdfjs-dist/build/pdf.worker.mjs', import.meta.url).toString();
let current:any=null,csrf='',contents:any[]=[],pendingAction:any=null,pendingUpload:File|null=null;
const $=<T extends Element>(s:string)=>document.querySelector<T>(s)!;const $$=<T extends Element>(s:string)=>[...document.querySelectorAll<T>(s)];
const api=async(path:string,options:RequestInit={})=>{const headers=new Headers(options.headers);if(options.body)headers.set('content-type','application/json');if(csrf&&!['GET','HEAD'].includes(options.method||'GET'))headers.set('x-csrf-token',csrf);const r=await fetch(`/api/${path}`,{...options,headers});const d=await r.json().catch(()=>({}));if(!r.ok){const e:any=new Error(d.error||'Operazione non riuscita.');e.reauthRequired=d.reauthRequired;throw e;}return d;};
const esc=(v:string)=>v.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]||c));
const slugify=(v:string)=>v.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'').slice(0,140);
const form=$<HTMLFormElement>('[data-editor-form]');
function showView(name:string){$$<HTMLElement>('[data-view]').forEach(x=>x.hidden=x.dataset.view!==name);$$<HTMLElement>('[data-view-button]').forEach(x=>x.classList.toggle('active',x.dataset.viewButton===name));if(name!=='editor')renderLists();}
$$<HTMLButtonElement>('[data-view-button]').forEach(b=>b.onclick=()=>showView(b.dataset.viewButton!));
$$<HTMLButtonElement>('[data-tab]').forEach(b=>b.onclick=()=>{$$<HTMLElement>('[data-pane]').forEach(x=>x.hidden=x.dataset.pane!==b.dataset.tab);$$<HTMLButtonElement>('[data-tab]').forEach(x=>x.classList.toggle('active',x===b));});
function values(){const f=new FormData(form);return{id:f.get('id'),title:String(f.get('title')||''),kind:f.get('kind'),category:f.get('category'),description:String(f.get('description')||''),body:String(f.get('body')||''),slug:String(f.get('slug')||''),tags:String(f.get('tags')||'').split(',').map(x=>x.trim()).filter(Boolean),image:String(f.get('image')||''),imageAlt:String(f.get('imageAlt')||'')}}
function paintChecks(){const v=values();for(const k of ['title','description','body','slug'])$<HTMLElement>(`[data-check="${k}"]`).classList.toggle('ok',Boolean((v as any)[k]));}
form.addEventListener('input',e=>{const target=e.target as HTMLInputElement;if(target.name==='title'&&!($<HTMLInputElement>('[name="slug"]')).value)$<HTMLInputElement>('[name="slug"]').value=slugify(target.value);paintChecks();});
function resetEditor(){form.reset();$<HTMLInputElement>('[name="id"]').value='';$<HTMLElement>('[data-editor-title]').textContent='Nuovo contenuto';$<HTMLElement>('[data-current-state]').textContent='Bozza privata';$<HTMLElement>('[data-current-state]').className='cms-state draft';$<HTMLButtonElement>('[data-publish]').disabled=true;$<HTMLElement>('[data-save-status]').textContent='Bozza non ancora salvata';paintChecks();showView('editor');}
$<HTMLElement>('[data-reset-editor]').addEventListener('click',resetEditor);$<HTMLElement>('[data-new]').addEventListener('click',resetEditor);
function edit(item:any){resetEditor();for(const [key,value] of Object.entries(item)){const el=form.elements.namedItem(key) as HTMLInputElement|HTMLTextAreaElement|HTMLSelectElement|null;if(el)el.value=Array.isArray(value)?value.join(', '):String(value??'');}$<HTMLElement>('[data-editor-title]').textContent=item.title;$<HTMLElement>('[data-current-state]').textContent=item.status==='published'?'Online':item.status==='hidden'?'Nascosto':'Bozza privata';$<HTMLElement>('[data-current-state]').className=`cms-state ${item.status}`;$<HTMLButtonElement>('[data-publish]').disabled=false;paintChecks();}
form.addEventListener('submit',async e=>{e.preventDefault();const v=values();try{const d=v.id?await api(`cms/${v.id}`,{method:'PATCH',body:JSON.stringify(v)}):await api('cms',{method:'POST',body:JSON.stringify(v)});await loadContents();edit(d.content);$<HTMLElement>('[data-save-status]').textContent='Bozza salvata adesso';$<HTMLElement>('[data-editor-status]').textContent='Salvataggio riuscito.';}catch(err){$<HTMLElement>('[data-editor-status]').textContent=(err as Error).message;}});
async function loadContents(){const d=await api('cms');contents=d.contents;renderLists();}
function renderLists(){const row=(x:any)=>`<article class="cms-row"><div><strong>${esc(x.title)}</strong><small>${esc(x.kind)} · ${esc(x.status)} · ${new Date(x.updatedAt+'Z').toLocaleString('it-IT')}</small></div><span class="cms-state ${x.status}">${x.status==='published'?'Online':x.status==='hidden'?'Nascosto':x.status==='trash'?'Cestino':'Bozza'}</span><div class="cms-row-actions">${x.status==='trash'?`<button class="button" data-action="restore" data-id="${x.id}">Ripristina</button><button class="button danger" data-action="delete" data-id="${x.id}">Elimina definitivamente</button>`:`<button class="button" data-edit="${x.id}">Modifica</button>${x.status==='published'?`<button class="button" data-action="hide" data-id="${x.id}">Nascondi</button>`:`<button class="button publish" data-action="publish" data-id="${x.id}">Pubblica</button>`}<button class="button" data-action="trash" data-id="${x.id}">Cestino</button>`}</div></article>`;$<HTMLElement>('[data-content-list]').innerHTML=contents.filter(x=>x.status!=='trash').map(row).join('')||'<p class="muted">Nessun contenuto.</p>';$<HTMLElement>('[data-trash-list]').innerHTML=contents.filter(x=>x.status==='trash').map(row).join('')||'<p class="muted">Il cestino è vuoto.</p>';$$<HTMLButtonElement>('[data-edit]').forEach(b=>b.onclick=()=>edit(contents.find(x=>x.id===b.dataset.edit)));$$<HTMLButtonElement>('[data-action]').forEach(b=>b.onclick=()=>askAction(b.dataset.action!,b.dataset.id!));}
function askAction(action:string,id:string){const item=contents.find(x=>x.id===id);pendingUpload=null;pendingAction={action,id};const deleting=action==='delete';$<HTMLElement>('[data-confirm-title]').textContent=action==='publish'?'Pubblicare il contenuto?':action==='hide'?'Nascondere il contenuto?':action==='restore'?'Ripristinare la bozza?':deleting?'Eliminare definitivamente?':'Spostare nel cestino?';$<HTMLElement>('[data-confirm-text]').textContent=deleting?`${item.title}. Verrà eliminato dal CMS e dal sito. Non sarà creato alcun backup e non potrai annullare l’operazione.`:`${item.title}. L’operazione verrà registrata e resterà recuperabile.`;$<HTMLButtonElement>('[data-confirm-ok]').classList.toggle('danger',deleting);$<HTMLDialogElement>('[data-confirm]').showModal();}
$<HTMLElement>('[data-confirm-cancel]').addEventListener('click',()=>$<HTMLDialogElement>('[data-confirm]').close());$<HTMLElement>('[data-confirm-ok]').addEventListener('click',async()=>{const p=pendingAction;$<HTMLDialogElement>('[data-confirm]').close();try{await api(`cms/${p.id}/action`,{method:'POST',body:JSON.stringify({action:p.action})});await loadContents();}catch(err){if((err as any).reauthRequired){pendingAction=p;$<HTMLDialogElement>('[data-reauth]').showModal();}else alert((err as Error).message);}});
$<HTMLFormElement>('[data-reauth-form]').addEventListener('submit',async e=>{e.preventDefault();const f=new FormData(e.currentTarget as HTMLFormElement);try{await api('auth/reauth',{method:'POST',body:JSON.stringify(Object.fromEntries(f))});$<HTMLDialogElement>('[data-reauth]').close();if(pendingUpload){const file=pendingUpload;pendingUpload=null;await uploadImage(file);}else if(pendingAction){await api(`cms/${pendingAction.id}/action`,{method:'POST',body:JSON.stringify({action:pendingAction.action})});await loadContents();}}catch(err){$<HTMLElement>('[data-reauth-status]').textContent=(err as Error).message;}});$<HTMLElement>('[data-close-reauth]').addEventListener('click',()=>$<HTMLDialogElement>('[data-reauth]').close());
$<HTMLButtonElement>('[data-publish]').addEventListener('click',()=>askAction('publish',String(values().id)));
const previewHtml=(markdown:string)=>{if(markdown.startsWith('<!--cms-rich-->'))return markdown.slice(15);return markdown.split(/\n{2,}/).map(block=>{const safe=esc(block.trim());if(!safe)return'';if(safe.startsWith('## '))return`<h2>${safe.slice(3)}</h2>`;if(safe.startsWith('### '))return`<h3>${safe.slice(4)}</h3>`;if(safe.split('\n').every(line=>/^[-*] /.test(line)))return`<ul>${safe.split('\n').map(line=>`<li>${line.slice(2)}</li>`).join('')}</ul>`;return`<p>${safe.replace(/\n/g,'<br>')}</p>`;}).join('');};
function openPreview(){const v=values();$<HTMLElement>('[data-preview-title]').textContent=v.title||'Titolo non ancora inserito';$<HTMLElement>('[data-preview-category]').textContent=String(v.category||'contenuto').toUpperCase();$<HTMLElement>('[data-preview-description]').textContent=v.description||'Qui apparirà la descrizione breve.';$<HTMLElement>('[data-preview-body]').innerHTML=previewHtml(v.body||'Qui apparirà il testo del contenuto.');const figure=$<HTMLElement>('[data-preview-figure]'),image=$<HTMLImageElement>('[data-preview-image]');figure.hidden=!v.image;if(v.image){image.src=v.image;image.alt=v.imageAlt||'';}$<HTMLDialogElement>('[data-preview-dialog]').showModal();}
$<HTMLElement>('[data-preview]').addEventListener('click',openPreview);$<HTMLElement>('[data-close-preview]').addEventListener('click',()=>$<HTMLDialogElement>('[data-preview-dialog]').close());$$<HTMLButtonElement>('[data-preview-mode]').forEach(button=>button.addEventListener('click',()=>{$$<HTMLButtonElement>('[data-preview-mode]').forEach(x=>x.classList.toggle('active',x===button));$<HTMLElement>('[data-preview-page]').classList.toggle('retro',button.dataset.previewMode==='retro');}));
async function pdfText(buffer:ArrayBuffer){const doc=await pdfjs.getDocument({data:new Uint8Array(buffer)}).promise;let text='';for(let i=1;i<=Math.min(doc.numPages,200);i++){const page=await doc.getPage(i),content=await page.getTextContent();text+=content.items.map((x:any)=>x.str).join(' ')+'\n\n';}return text;}
const allowedCss=new Set(['color','background','background-color','border','border-color','border-style','border-width','border-radius','padding','padding-top','padding-right','padding-bottom','padding-left','margin','margin-top','margin-right','margin-bottom','margin-left','display','grid-template-columns','grid-template-rows','gap','column-gap','row-gap','align-items','justify-content','text-align','font-size','font-weight','font-style','line-height','letter-spacing','width','min-width','max-width','height','min-height','max-height','object-fit','box-shadow','opacity','transform','overflow','overflow-x','overflow-y']);
function safeStyle(value:string){return value.split(';').map(x=>x.trim()).filter(Boolean).map(rule=>{const i=rule.indexOf(':');if(i<1)return'';const name=rule.slice(0,i).trim().toLowerCase(),val=rule.slice(i+1).trim();return allowedCss.has(name)&&!/url\s*\(|expression|javascript|@import|position\s*:/i.test(`${name}:${val}`)?`${name}:${val}`:'';}).filter(Boolean).join(';');}
function inlineDocumentStyles(doc:Document){for(const style of [...doc.querySelectorAll('style')]){const css=style.textContent||'';for(const match of css.matchAll(/([^{}@]+)\{([^{}]+)\}/g)){const declarations=safeStyle(match[2]);if(!declarations)continue;for(const selector of match[1].split(',').map(x=>x.trim()).filter(Boolean)){try{doc.querySelectorAll(selector).forEach(el=>{const old=safeStyle(el.getAttribute('style')||'');el.setAttribute('style',[old,declarations].filter(Boolean).join(';'));});}catch{}}}style.remove();}}
function sanitizeRichDocument(doc:Document){inlineDocumentStyles(doc);doc.querySelectorAll('script,iframe,object,embed,form,input,button,meta,link,base,noscript,template,foreignObject,use,animate,set,audio,source').forEach(x=>x.remove());for(const el of [...doc.body.querySelectorAll('*')]){for(const attr of [...el.attributes]){const name=attr.name.toLowerCase(),value=attr.value.trim();if(name.startsWith('on')||name==='srcdoc'||name==='formaction')el.removeAttribute(attr.name);else if(name==='style'){const safe=safeStyle(value);safe?el.setAttribute('style',safe):el.removeAttribute('style');}else if(['href','src','xlink:href'].includes(name)&&/^(javascript|vbscript|data:text\/html)/i.test(value))el.removeAttribute(attr.name);}}return `<!--cms-rich--><div class="cms-rich">${doc.body.innerHTML}</div>`;}
async function uploadAssetFile(file:File){if(file.size>5*1024*1024)throw new Error(`L’immagine ${file.name} supera 5 MB.`);const response=await fetch('/api/cms/assets',{method:'POST',headers:{'content-type':file.type,'x-file-name':encodeURIComponent(file.name),'x-csrf-token':csrf},body:file});const data=await response.json().catch(()=>({}));if(!response.ok){if(data.reauthRequired)throw new Error('Per caricare le immagini riconferma prima password e secondo fattore, poi importa nuovamente il file.');throw new Error(data.error||`Non riesco a caricare ${file.name}.`);}return String(data.path);}
function dataImageFile(src:string,index:number){const m=src.match(/^data:(image\/(?:png|jpeg|webp|gif));base64,(.+)$/i);if(!m)return null;const bytes=Uint8Array.from(atob(m[2]),c=>c.charCodeAt(0)),ext=m[1].split('/')[1].replace('jpeg','jpg');return new File([bytes],`immagine-${index}.${ext}`,{type:m[1]});}
function normalPath(value:string){const out:string[]=[];for(const part of value.replace(/\\/g,'/').split('/')){if(!part||part==='.')continue;if(part==='..')out.pop();else out.push(part);}return out.join('/');}
async function prepareHtml(text:string,zipEntries:Map<string,any>|null=null,base=''){const doc=new DOMParser().parseFromString(text,'text/html'),images=[...doc.querySelectorAll<HTMLImageElement>('img[src]')];for(let i=0;i<images.length;i++){const image=images[i],src=image.getAttribute('src')||'';if(/^https?:\/\//i.test(src)||src.startsWith('/'))continue;if(src.startsWith('data:image/')){const file=dataImageFile(src,i+1);if(file)image.src=await uploadAssetFile(file);continue;}if(!zipEntries)throw new Error(`L’immagine “${src}” è separata dall’HTML. Crea uno ZIP con il file HTML e le sue immagini, poi importalo.`);const key=normalPath(`${base}/${decodeURIComponent(src.split(/[?#]/)[0])}`),entry=zipEntries.get(key);if(!entry)throw new Error(`Nello ZIP non trovo l’immagine “${src}”.`);const ext=key.split('.').pop()?.toLowerCase(),mime=ext==='png'?'image/png':ext==='webp'?'image/webp':ext==='gif'?'image/gif':ext==='jpg'||ext==='jpeg'?'image/jpeg':'';if(!mime)throw new Error(`Formato immagine non supportato: ${src}`);const blob=await entry.async('blob'),file=new File([blob],key.split('/').pop()||`immagine.${ext}`,{type:mime});image.src=await uploadAssetFile(file);}return sanitizeRichDocument(doc);}
async function readImported(file:File):Promise<string>{if(file.size>20*1024*1024)throw new Error('Il file supera 20 MB.');const ext=file.name.split('.').pop()?.toLowerCase();if(['md','txt'].includes(ext||''))return file.text();if(['html','htm'].includes(ext||''))return prepareHtml(await file.text());if(ext==='docx'){const r=await (mammoth as any).convertToHtml({arrayBuffer:await file.arrayBuffer()});return prepareHtml(r.value);}if(ext==='pdf')return pdfText(await file.arrayBuffer());if(ext==='zip'){const zip=await JSZip.loadAsync(await file.arrayBuffer()),entries=Object.values(zip.files).filter((x:any)=>!x.dir&&!x.name.startsWith('__MACOSX/')).slice(0,200) as any[],entryMap=new Map(entries.map(x=>[normalPath(x.name),x]));const main=entries.find(x=>/\.(md|txt|html?)$/i.test(x.name));if(!main)throw new Error('Nello ZIP non trovo un file di testo, Markdown o HTML.');if(Number(main?._data?.uncompressedSize||0)>2*1024*1024)throw new Error('Il documento nello ZIP supera 2 MB.');const text=await main.async('string');if(text.length>2*1024*1024)throw new Error('Il documento nello ZIP è troppo grande.');if(/\.html?$/i.test(main.name)){const base=normalPath(main.name).split('/').slice(0,-1).join('/');return prepareHtml(text,entryMap,base);}return text;}throw new Error('Formato non supportato.');}
$<HTMLInputElement>('[data-import-file]').addEventListener('change',async e=>{const file=(e.currentTarget as HTMLInputElement).files?.[0];if(!file)return;const status=$<HTMLElement>('[data-import-status]');status.textContent='Lettura in corso…';try{const text=await readImported(file);$<HTMLTextAreaElement>('[name="body"]').value=text.slice(0,250000);if(!$<HTMLInputElement>('[name="title"]').value){const name=file.name.replace(/\.[^.]+$/,'').replace(/[-_]+/g,' ');$<HTMLInputElement>('[name="title"]').value=name;$<HTMLInputElement>('[name="slug"]').value=slugify(name);}$<HTMLButtonElement>('[data-tab="write"]').click();status.textContent='File importato nella bozza. Controlla il testo prima di salvare.';paintChecks();}catch(err){status.textContent=(err as Error).message;}});
async function uploadImage(file:File){const status=$<HTMLElement>('[data-image-status]');if(file.size>5*1024*1024){status.textContent='La foto supera 5 MB.';return;}status.textContent='Caricamento sicuro della foto…';try{const response=await fetch('/api/cms/assets',{method:'POST',headers:{'content-type':file.type,'x-file-name':encodeURIComponent(file.name),'x-csrf-token':csrf},body:file});const data=await response.json().catch(()=>({}));if(!response.ok){if(data.reauthRequired){pendingUpload=file;pendingAction=null;$<HTMLDialogElement>('[data-reauth]').showModal();return;}throw new Error(data.error||'Caricamento non riuscito.');}$<HTMLInputElement>('[name="image"]').value=data.path;status.textContent='Foto caricata. Ora completa la descrizione della foto.';}catch(err){status.textContent=(err as Error).message;}}
$<HTMLInputElement>('[data-image-file]').addEventListener('change',async e=>{const file=(e.currentTarget as HTMLInputElement).files?.[0];if(file)await uploadImage(file);});
$<HTMLElement>('[data-logout]').addEventListener('click',async()=>{await api('auth/logout',{method:'POST'});location.href='/staff/';});
api('auth/me').then(async d=>{current=d.user;csrf=d.csrf;$<HTMLElement>('[data-user]').textContent=current.name;await loadContents();paintChecks();}).catch(()=>location.href='/staff/');
</script></body></html>
