---
import Base from '../layouts/Base.astro';
if (!import.meta.env.DEV) return Astro.redirect('/404/');
---
<Base title="Redazione locale — Retro di testa" noindex><section class="wrap narrow archive"><p class="eyebrow">IL TUO QUADERNO</p><h1>Un’idea diventa articolo.</h1><p class="lead">Scrivi, importa, scarica. Nessun account, nessun abbonamento.</p><p class="editor-note">Questo editor prepara file Markdown. <strong>Non salva direttamente nella cartella del sito e non pubblica.</strong> Dopo il download, copia il file in <code>src/content/articoli/</code>. Per riaprire un articolo usa “Importa”. Salva una copia prima di chiudere questa pagina.</p><form class="editor" id="editor"><label>Importa un articolo Markdown<input id="import" type="file" accept=".md,text/markdown"/></label><label>Titolo<input name="title" required maxlength="180"/></label><label>Descrizione breve<input name="description" required maxlength="320"/></label><label>Categoria<select name="category"><option value="guide">Guide</option><option value="soluzioni">Soluzioni</option><option value="test">Test</option><option value="recensioni">Recensioni</option></select></label><label>Data<input type="date" name="date" required/></label><label>Argomenti, separati da virgole<input name="tags" placeholder="NAS, rete, backup"/></label><label>Immagine (facoltativa, percorso locale)<input name="image" placeholder="/immagini/la-mia-foto.jpg"/></label><label>Descrizione dell’immagine<input name="imageAlt"/></label><label class="check"><input name="draft" type="checkbox" checked/> Bozza: escludi dalla build pubblica</label><label>Testo dell’articolo<textarea name="body" required placeholder="## Da dove partiamo&#10;&#10;Scrivi qui. Usa ## per i titoli, **testo** per il grassetto e - per gli elenchi."></textarea></label><div class="editor-actions"><button class="button dark" type="submit">Scarica articolo .md ↓</button></div><p id="editor-status" role="status"></p></form></section></Base>
<script>
const form=document.querySelector<HTMLFormElement>('#editor')!;
const field=(name:string)=>form.elements.namedItem(name) as HTMLInputElement;
field('date').value=new Date().toLocaleDateString('sv-SE');
const status=document.querySelector('#editor-status')!;
form.addEventListener('submit',e=>{e.preventDefault();const data:Record<string,unknown>={title:field('title').value.trim(),description:field('description').value.trim(),category:field('category').value,date:field('date').value,draft:field('draft').checked,tags:field('tags').value.split(',').map(t=>t.trim()).filter(Boolean)};if(field('image').value.trim()){data.image=field('image').value.trim();data.imageAlt=field('imageAlt').value.trim();}const content='---\n'+Object.entries(data).map(([k,v])=>`${k}: ${JSON.stringify(v)}`).join('\n')+'\n---\n\n'+field('body').value+'\n';const slug=field('title').value.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'')||'articolo';const url=URL.createObjectURL(new Blob([content],{type:'text/markdown;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download=slug+'.md';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);status.textContent='File preparato. Copialo in src/content/articoli/ per vederlo sul sito. Se stai modificando un articolo, sostituisci il file originale mantenendo il suo nome.';});
document.querySelector<HTMLInputElement>('#import')!.addEventListener('change',async e=>{const file=(e.target as HTMLInputElement).files?.[0];if(!file)return;try{const text=(await file.text()).replace(/\r\n/g,'\n');const match=text.match(/^---\n([\s\S]*?)\n---\n([\s\S]*)$/);if(!match)throw new Error('Formato non riconosciuto. Usa un file creato da questo editor o fornito con il sito.');const data:Record<string,any>={};for(const line of match[1].split('\n')){if(!line.trim())continue;const colon=line.indexOf(':');if(colon<0)throw new Error('Metadati non riconosciuti.');const key=line.slice(0,colon);data[key]=JSON.parse(line.slice(colon+1).trim());}if(!data.title||!data.description||!['guide','soluzioni','test','recensioni'].includes(data.category))throw new Error('Titolo, descrizione o categoria non validi.');for(const name of ['title','description','category','date','image','imageAlt'])field(name).value=data[name]||'';field('tags').value=(data.tags||[]).join(', ');field('draft').checked=data.draft!==false;field('body').value=match[2].trim();status.textContent='Articolo importato. Le modifiche restano qui finché non scarichi il file.';}catch(error){status.textContent=error instanceof Error?error.message:'Impossibile importare il file.'}});
</script>