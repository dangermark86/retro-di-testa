---
import '../styles/global.css';
---
<!doctype html><html lang="it"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><title>Area riservata staff</title><link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48"/><link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><style>.staff-menu-link{display:block;padding:13px 14px;border-radius:8px;background:#63d9ed;color:#071424!important;font-weight:900;margin-bottom:8px}.staff-menu-link:hover{background:#fff}[data-recovery-dialog]{max-width:540px;border:0;border-radius:14px;padding:28px}[data-recovery-dialog]::backdrop{background:#06101dcc}[data-recovery-codes]{display:block;white-space:pre-wrap;padding:16px;background:#edf2fc;border-radius:8px;font:700 17px/1.7 monospace;margin:18px 0}[data-2fa-qr]{display:block;background:#fff;padding:10px;border-radius:10px;margin:14px 0;max-width:100%;height:auto}</style></head><body class="staff-body">
<main class="staff-shell">
  <section class="staff-login" data-login>
    <img src="/immagini/logo-retro-di-testa.jpg" alt="" width="74" height="74"/><h1>Area riservata staff</h1>
    <form data-login-form><label>Nome utente<input name="username" required autocomplete="username"/></label><label>Password<input name="password" type="password" required autocomplete="current-password"/></label><label data-login-totp hidden>Codice a 6 cifre oppure codice di recupero<input name="totp" maxlength="20" autocomplete="one-time-code"/></label><button class="button dark" type="submit">Accedi</button><button class="link-button" type="button" data-forgot>Password dimenticata?</button><p data-login-status role="status"></p></form>
    <form data-reset-request hidden><label>Nome utente o email<input name="account" required/></label><button class="button dark" type="submit">Invia il collegamento</button><button class="link-button" type="button" data-back-login>Torna all’accesso</button><p data-reset-status role="status"></p></form>
    <form data-reset hidden><h2>Scegli una nuova password</h2><label>Nuova password<input name="newPassword" type="password" minlength="14" required autocomplete="new-password"/></label><small>Almeno 14 caratteri con maiuscola, minuscola, numero e simbolo.</small><button class="button dark" type="submit">Salva nuova password</button><p data-reset-complete-status role="status"></p></form>
  </section>

  <section class="staff-app" data-app hidden>
    <header class="staff-top"><a href="/" class="staff-brand"><img src="/immagini/logo-retro-di-testa.jpg" alt="" width="52" height="52"/>Retro di testa</a><div><span data-user-label></span><button class="link-button" type="button" data-logout>Esci</button></div></header>
    <div class="staff-layout"><aside><nav data-menu></nav></aside><div class="staff-main">
      <section data-panel="overview"><div class="staff-heading-row"><div><p class="eyebrow" data-period-label>ULTIMI 30 GIORNI</p><h1>Panoramica</h1></div><label class="staff-period">Periodo<select data-stats-period><option value="7">7 giorni</option><option value="30" selected>30 giorni</option><option value="90">90 giorni</option><option value="365">365 giorni</option></select></label></div><div class="staff-kpis staff-kpis-wide"><article><span>Visitatori stimati</span><strong data-kpi-visitors>0</strong></article><article><span>Pagine viste</span><strong data-kpi-views>0</strong></article><article><span>Lettura media</span><strong data-kpi-completion>0%</strong></article><article><span>Gradimento</span><strong data-kpi-likes>0</strong><small data-kpi-dislikes>0 voti negativi</small></article><article><span>Commenti pubblicati</span><strong data-kpi-comments>0</strong></article></div><div class="staff-chart-heading"><h2>Andamento</h2><div><button class="button" type="button" data-export-chart="svg">Scarica SVG</button><button class="button" type="button" data-export-chart="png">Scarica PNG</button></div></div><div class="staff-chart staff-chart-svg"><svg viewBox="0 0 1000 260" role="img" aria-label="Grafico delle visualizzazioni" data-traffic-chart></svg></div><h2>Paesi approssimativi</h2><div class="staff-list" data-countries></div></section>
      <section data-panel="content" hidden><p class="eyebrow">LETTURE</p><h1>Contenuti</h1><div class="staff-tools"><label>Cerca<input type="search" data-content-search placeholder="Titolo del contenuto"/></label><label>Tipo<select data-content-type><option value="">Tutti</option><option value="Articolo">Articoli</option><option value="Progetto">Progetti</option></select></label><button class="button" type="button" data-export-stats>Esporta CSV</button></div><div class="staff-table-wrap"><table><thead><tr><th>Contenuto</th><th>Tipo</th><th>Visite</th><th>Visitatori</th><th>Lettura stimata</th></tr></thead><tbody data-content-rows></tbody></table></div><p class="muted" data-content-empty hidden>Nessun contenuto corrisponde ai filtri.</p></section>
      <section data-panel="timeline" hidden><p class="eyebrow">ATTIVITÀ ORARIA</p><h1>Quando arrivano i visitatori</h1><p class="muted">I dati orari iniziano dalla pubblicazione di questa funzione. Le statistiche precedenti restano disponibili, aggregate per giorno.</p><div class="staff-tools"><label>Cerca<input type="search" data-timeline-search placeholder="Contenuto o paese"/></label><button class="button" type="button" data-export-timeline>Esporta CSV</button></div><div class="staff-table-wrap"><table><thead><tr><th>Data e ora</th><th>Contenuto</th><th>Tipo</th><th>Paese</th><th>Visite</th><th>Visitatori</th></tr></thead><tbody data-timeline-rows></tbody></table></div><p class="muted" data-timeline-empty hidden>Nessuna visita oraria disponibile per questo periodo.</p></section>
      <section data-panel="comments" hidden><p class="eyebrow">MODERAZIONE</p><h1>Commenti</h1><div class="staff-list" data-comments-list></div></section>
      <section data-panel="trash" hidden><p class="eyebrow">CESTINO</p><h1>Commenti cancellati</h1><div class="staff-list" data-trash-list></div></section>
      <section data-panel="roles" hidden><p class="eyebrow">SOLO PROPRIETARIO</p><h1>Gestisci ruoli</h1><button class="button dark" type="button" data-new-account>Aggiungi amministratore o moderatore</button><div class="staff-list" data-users-list></div>
        <form class="staff-card account-form" data-account-form hidden><input name="id" type="hidden"/><h2 data-account-title>Nuovo account</h2><div class="form-grid"><label>Nome e cognome<input name="name" required/></label><label>Email<input name="email" type="email" required/></label><label>Nome utente<input name="username" required/></label><label>Ruolo<select name="role"><option value="admin">Amministratore</option><option value="moderator">Moderatore</option></select></label></div><div class="staff-actions"><button class="button dark" type="submit">Salva</button><button class="button" type="button" data-cancel-account>Annulla</button></div><div data-existing-actions hidden><hr/><label>Nuova password<input name="newPassword" type="password" minlength="12"/></label><button class="button" type="button" data-set-password>Imposta nuova password</button><button class="button" type="button" data-toggle-account></button><button class="button danger" type="button" data-delete-account>Cancella account</button></div><p data-account-status role="status"></p></form>
      </section>
      <section data-panel="account" hidden><p class="eyebrow">PROFILO</p><h1>Il mio account</h1><dl class="account-details"><dt>Nome</dt><dd data-account-name></dd><dt>Email</dt><dd data-account-email></dd><dt>Nome utente</dt><dd data-account-username></dd><dt>Ruolo</dt><dd data-account-role></dd></dl><form data-owner-password hidden><h2>Cambia password</h2><label>Password attuale<input name="currentPassword" type="password" required/></label><label>Nuova password<input name="newPassword" type="password" minlength="14" required/></label><small>Almeno 14 caratteri con maiuscola, minuscola, numero e simbolo.</small><button class="button dark" type="submit">Cambia password</button><p data-password-status role="status"></p></form></section>
      <section data-panel="security" hidden><p class="eyebrow">PROTEZIONE ACCOUNT</p><h1>Sicurezza</h1><div class="staff-kpis"><article><span>Verifica in due passaggi</span><strong data-security-2fa>Controllo…</strong></article><article><span>Sessioni aperte</span><strong data-security-session-count>0</strong></article></div><div class="staff-card" data-2fa-setup><h2>Verifica in due passaggi</h2><p>Oltre alla password, l’accesso richiederà un codice temporaneo generato dal telefono.</p><button class="button dark" type="button" data-start-2fa>Attiva il secondo fattore</button><div data-2fa-confirm hidden><p>Inquadra il QR con l’app di autenticazione del telefono. In alternativa inserisci manualmente la chiave mostrata sotto.</p><canvas data-2fa-qr width="220" height="220"></canvas><output data-2fa-secret></output><label>Codice mostrato dall’app<input data-2fa-code inputmode="numeric" maxlength="6"/></label><button class="button dark" type="button" data-confirm-2fa>Conferma e attiva</button></div><p data-2fa-status role="status"></p></div><h2>Dispositivi collegati</h2><div class="staff-list" data-security-sessions></div><h2>Registro delle operazioni di sicurezza</h2><div class="staff-list" data-security-events></div></section>
    </div></div>
  </section>
</main>
<dialog data-password-dialog><form method="dialog"><h2>Account creato</h2><p>Copia ora la password provvisoria e consegnala alla persona interessata. Dopo aver chiuso questa finestra non sarà più visibile.</p><output data-temp-password></output><button class="button dark">Ho copiato la password</button></form></dialog>
<dialog data-recovery-dialog><form method="dialog"><h2>Salva i codici di recupero</h2><p>Conservali fuori dal sito. Ogni codice funziona una sola volta se perdi il telefono.</p><output data-recovery-codes></output><button class="button dark">Li ho salvati</button></form></dialog>
<dialog data-reauth-dialog><form data-reauth-form><h2>Conferma che sei tu</h2><p>Per proteggere le operazioni importanti, inserisci nuovamente le credenziali.</p><label>Password<input name="password" type="password" required autocomplete="current-password"/></label><label>Codice di sicurezza<input name="totp" inputmode="numeric" maxlength="6" autocomplete="one-time-code"/></label><p data-reauth-status role="status"></p><div class="staff-actions"><button class="button dark" type="submit">Conferma</button><button class="button" type="button" data-close-reauth>Annulla</button></div></form></dialog>
<script>
import QRCode from 'qrcode';
type User={id:string,name:string,email:string,username:string,role:'owner'|'admin'|'moderator',active:boolean,mustChange?:boolean,totpEnabled?:boolean};
let current:User|null=null,csrf='',selected:User|null=null,statsData:any=null,statsDays=30;
const $=<T extends Element>(s:string)=>document.querySelector<T>(s)!;
const escapeHtml=(v:string)=>v.replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]||c));
const api=async(path:string,options:RequestInit={})=>{const headers=new Headers(options.headers);if(options.body)headers.set('content-type','application/json');if(csrf&&!['GET','HEAD'].includes(options.method||'GET'))headers.set('x-csrf-token',csrf);const r=await fetch(`/api/${path}`,{...options,headers});const data=await r.json().catch(()=>({}));if(!r.ok)throw new Error(data.error||'Operazione non riuscita.');return data;};
const roleName=(r:string)=>r==='owner'?'Proprietario':r==='admin'?'Amministratore':'Moderatore';
const showLogin=()=>{$<HTMLElement>('[data-app]').hidden=true;$<HTMLElement>('[data-login]').hidden=false;};
const panels=['overview','content','timeline','comments','trash','roles','account','security'];
const showPanel=async(name:string)=>{panels.forEach(p=>$<HTMLElement>(`[data-panel="${p}"]`).hidden=p!==name);document.querySelectorAll('[data-menu] button').forEach(b=>b.classList.toggle('active',(b as HTMLElement).dataset.target===name));if(name==='comments')await loadComments('published');if(name==='trash')await loadComments('trash');if(name==='roles')await loadUsers();if(name==='security')await loadSecurity();};
const start=async(data:any)=>{current=data.user;csrf=data.csrf;$<HTMLElement>('[data-login]').hidden=true;$<HTMLElement>('[data-app]').hidden=false;$<HTMLElement>('[data-user-label]').textContent=`${current!.name} · ${roleName(current!.role)}`;$<HTMLElement>('[data-account-name]').textContent=current!.name;$<HTMLElement>('[data-account-email]').textContent=current!.email;$<HTMLElement>('[data-account-username]').textContent=current!.username;$<HTMLElement>('[data-account-role]').textContent=roleName(current!.role);$<HTMLElement>('[data-owner-password]').hidden=false;const allowed=current!.role==='moderator'?['comments','trash','account']:current!.role==='admin'?['overview','content','timeline','comments','trash','account']:panels;const cmsLink=current!.role==='moderator'?'':`<a class="staff-menu-link" href="/staff/cms/">CMS · Scrivi e pubblica</a>`;$<HTMLElement>('[data-menu]').innerHTML=cmsLink+allowed.map(p=>`<button type="button" data-target="${p}">${({overview:'Panoramica',content:'Statistiche contenuti',timeline:'Visite per ora',comments:'Commenti',trash:'Commenti cancellati',roles:'Gestisci ruoli',account:'Il mio account',security:'Sicurezza'} as any)[p]}</button>`).join('');document.querySelectorAll<HTMLButtonElement>('[data-menu] button').forEach(b=>b.addEventListener('click',()=>showPanel(b.dataset.target!)));const requested=location.hash==='#security'&&allowed.includes('security')?'security':allowed[0];if(current!.mustChange){showPanel('account');$<HTMLElement>('[data-password-status]').textContent='Al primo accesso devi sostituire la password provvisoria.';}else{showPanel(requested);}if(current!.role!=='moderator'&&!current!.mustChange)loadStats();};
const renderContent=()=>{if(!statsData)return;const query=$<HTMLInputElement>('[data-content-search]').value.trim().toLowerCase(),type=$<HTMLSelectElement>('[data-content-type]').value,rows=statsData.content.filter((x:any)=>(!query||x.title.toLowerCase().includes(query))&&(!type||x.type===type));$<HTMLElement>('[data-content-rows]').innerHTML=rows.map((x:any)=>`<tr><td>${escapeHtml(x.title)}</td><td>${x.type}</td><td>${x.views}</td><td>${x.visitors}</td><td>${x.completion}%</td></tr>`).join('');$<HTMLElement>('[data-content-empty]').hidden=rows.length>0;};
const renderTimeline=()=>{if(!statsData)return;const query=$<HTMLInputElement>('[data-timeline-search]').value.trim().toLowerCase(),rows=(statsData.timeline||[]).filter((x:any)=>!query||`${x.title} ${x.country}`.toLowerCase().includes(query));$<HTMLElement>('[data-timeline-rows]').innerHTML=rows.map((x:any)=>`<tr><td>${new Date(x.hour+'Z').toLocaleString('it-IT',{dateStyle:'short',timeStyle:'short'})}</td><td>${escapeHtml(x.title)}</td><td>${x.type}</td><td>${escapeHtml(x.country)}</td><td>${x.views}</td><td>${x.visitors}</td></tr>`).join('');$<HTMLElement>('[data-timeline-empty]').hidden=rows.length>0;};
const renderChart=()=>{if(!statsData)return;const svg=$<SVGElement>('[data-traffic-chart]'),data=statsData.daily,width=1000,height=260,pad=46,max=Math.max(1,...data.map((x:any)=>Number(x.views))),step=data.length>1?(width-pad*2)/(data.length-1):0,point=(x:any,i:number)=>`${pad+i*step},${height-pad-(Number(x.views)/max)*(height-pad*2)}`,line=data.map(point).join(' ');svg.innerHTML=`<rect width="${width}" height="${height}" rx="18" fill="#101e35"/><g stroke="#ffffff18">${[0,1,2,3,4].map(i=>`<line x1="${pad}" y1="${pad+i*(height-pad*2)/4}" x2="${width-pad}" y2="${pad+i*(height-pad*2)/4}"/>`).join('')}</g>${data.length?`<polyline points="${line}" fill="none" stroke="#79dcf0" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>${data.map((x:any,i:number)=>`<g><circle cx="${pad+i*step}" cy="${height-pad-(Number(x.views)/max)*(height-pad*2)}" r="7" fill="#ff554e"/><text x="${pad+i*step}" y="${height-16}" text-anchor="middle" fill="#b8c7da" font-size="13">${x.day.slice(5)}</text><text x="${pad+i*step}" y="${height-pad-(Number(x.views)/max)*(height-pad*2)-14}" text-anchor="middle" fill="white" font-size="14">${x.views}</text></g>`).join('')}`:`<text x="500" y="135" text-anchor="middle" fill="#b8c7da" font-size="20">Nessun dato disponibile</text>`}`;};
const loadStats=async()=>{const d=await api(`stats/summary?days=${statsDays}`);statsData=d;$<HTMLElement>('[data-period-label]').textContent=`ULTIMI ${d.days} GIORNI`;$<HTMLElement>('[data-kpi-visitors]').textContent=d.totals.visitors;$<HTMLElement>('[data-kpi-views]').textContent=d.totals.views;$<HTMLElement>('[data-kpi-completion]').textContent=`${d.totals.completion||0}%`;$<HTMLElement>('[data-kpi-likes]').textContent=d.reactions.likes;$<HTMLElement>('[data-kpi-dislikes]').textContent=`${d.reactions.dislikes} voti negativi`;$<HTMLElement>('[data-kpi-comments]').textContent=d.comments;$<HTMLElement>('[data-countries]').innerHTML=d.countries.length?d.countries.map((x:any)=>`<article class="staff-card"><strong>${escapeHtml(x.country)}</strong><span>${x.views} visualizzazioni</span></article>`).join(''):'<p class="muted">Nessun dato disponibile.</p>';renderChart();renderContent();renderTimeline();};
document.querySelector<HTMLSelectElement>('[data-stats-period]')?.addEventListener('change',async e=>{statsDays=Number((e.currentTarget as HTMLSelectElement).value);await loadStats();});
document.querySelector<HTMLInputElement>('[data-content-search]')?.addEventListener('input',renderContent);document.querySelector<HTMLSelectElement>('[data-content-type]')?.addEventListener('change',renderContent);
document.querySelector<HTMLButtonElement>('[data-export-stats]')?.addEventListener('click',()=>{if(!statsData)return;const quote=(v:any)=>`"${String(v??'').replace(/"/g,'""')}"`,lines=[['Contenuto','Tipo','Visite','Visitatori','Lettura stimata'],...statsData.content.map((x:any)=>[x.title,x.type,x.views,x.visitors,`${x.completion}%`])].map(row=>row.map(quote).join(';')).join('\n'),blob=new Blob(['\ufeff'+lines],{type:'text/csv;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=`retro-di-testa-statistiche-${statsDays}-giorni.csv`;a.click();URL.revokeObjectURL(url);});
document.querySelector<HTMLInputElement>('[data-timeline-search]')?.addEventListener('input',renderTimeline);
document.querySelector<HTMLButtonElement>('[data-export-timeline]')?.addEventListener('click',()=>{if(!statsData)return;const quote=(v:any)=>`"${String(v??'').replace(/"/g,'""')}"`,lines=[['Data e ora','Contenuto','Tipo','Paese','Visite','Visitatori'],...(statsData.timeline||[]).map((x:any)=>[new Date(x.hour+'Z').toLocaleString('it-IT'),x.title,x.type,x.country,x.views,x.visitors])].map(row=>row.map(quote).join(';')).join('\n'),blob=new Blob(['\ufeff'+lines],{type:'text/csv;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=`retro-di-testa-visite-orarie-${statsDays}-giorni.csv`;a.click();URL.revokeObjectURL(url);});
document.querySelectorAll<HTMLButtonElement>('[data-export-chart]').forEach(button=>button.addEventListener('click',()=>{const svg=$<SVGElement>('[data-traffic-chart]'),source=new XMLSerializer().serializeToString(svg),type=button.dataset.exportChart;if(type==='svg'){const blob=new Blob([source],{type:'image/svg+xml'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=`retro-di-testa-grafico-${statsDays}-giorni.svg`;a.click();URL.revokeObjectURL(url);return;}const image=new Image(),url=URL.createObjectURL(new Blob([source],{type:'image/svg+xml'}));image.onload=()=>{const canvas=document.createElement('canvas');canvas.width=1600;canvas.height=416;canvas.getContext('2d')!.drawImage(image,0,0,1600,416);URL.revokeObjectURL(url);canvas.toBlob(blob=>{if(!blob)return;const png=URL.createObjectURL(blob),a=document.createElement('a');a.href=png;a.download=`retro-di-testa-grafico-${statsDays}-giorni.png`;a.click();URL.revokeObjectURL(png);},'image/png');};image.src=url;}));
const loadComments=async(status:string)=>{const d=await api(`staff-comments?status=${status}`),box=$<HTMLElement>(status==='trash'?'[data-trash-list]':'[data-comments-list]');box.innerHTML=d.comments.length?d.comments.map((c:any)=>`<article class="staff-card" data-comment="${c.id}"><div><small>${escapeHtml(c.content_type)} · ${escapeHtml(c.content_title)} · ${escapeHtml(c.country)}</small><h3>${escapeHtml(c.author)}</h3><p>${escapeHtml(c.body)}</p><small>${new Date(c.created_at+'Z').toLocaleString('it-IT')} · ${c.likes} Mi piace · ${c.dislikes} Non mi piace</small></div><div class="staff-actions">${status==='trash'?'<button data-action="restore">Ripristina</button>':`<button data-action="feature">${c.featured?'Togli badge':'♥ Retro di testa'}</button><button class="danger" data-action="delete">Cancella commento</button>`}</div></article>`).join(''):'<p class="muted">Nessun commento in questa sezione.</p>';box.querySelectorAll<HTMLButtonElement>('[data-action]').forEach(b=>b.addEventListener('click',async()=>{const action=b.dataset.action!,card=b.closest<HTMLElement>('[data-comment]')!;if(action==='delete'&&!confirm('Vuoi cancellare questo commento? Potrai ripristinarlo dal cestino.'))return;await api(`comments/${card.dataset.comment}`,{method:'PATCH',body:JSON.stringify({action})});await loadComments(status);}));};
const loadUsers=async()=>{const d=await api('staff');$<HTMLElement>('[data-users-list]').innerHTML=d.users.map((u:User)=>`<button class="staff-card user-row" data-user="${u.id}" type="button"><span><strong>${escapeHtml(u.name)}</strong><small>${escapeHtml(u.email)} · ${escapeHtml(u.username)}</small></span><span>${roleName(u.role)} · ${u.active?'Attivo':'Disattivato'}</span></button>`).join('');$<HTMLElement>('[data-users-list]').querySelectorAll<HTMLButtonElement>('[data-user]').forEach(b=>b.addEventListener('click',()=>openAccount(d.users.find((u:User)=>u.id===b.dataset.user))));};
const eventName=(name:string)=>({login_success:'Accesso riuscito',login_failed:'Tentativo di accesso fallito',totp_failed:'Codice di sicurezza errato',totp_enabled:'Secondo fattore attivato',reauth_success:'Identità riconfermata',session_revoked:'Sessione chiusa',cms_created:'Bozza creata',cms_publish:'Contenuto pubblicato',cms_hide:'Contenuto nascosto',cms_trash:'Contenuto spostato nel cestino'} as any)[name]||name;
const loadSecurity=async()=>{const d=await api('auth/security');$<HTMLElement>('[data-security-2fa]').textContent=d.totpEnabled?'Attiva':'Non attiva';$<HTMLElement>('[data-security-session-count]').textContent=d.sessions.length;$<HTMLElement>('[data-start-2fa]').hidden=d.totpEnabled;$<HTMLElement>('[data-security-sessions]').innerHTML=d.sessions.map((s:any)=>`<article class="staff-card"><div><strong>${s.current?'Questo dispositivo':'Altro dispositivo'}</strong><small>${escapeHtml(s.userAgent||'Browser non riconosciuto')} · accesso ${new Date(s.createdAt+'Z').toLocaleString('it-IT')}</small></div>${s.current?'':`<button class="button danger" type="button" data-revoke-session="${s.id}">Chiudi sessione</button>`}</article>`).join('')||'<p class="muted">Nessuna sessione aperta.</p>';$<HTMLElement>('[data-security-events]').innerHTML=d.events.map((e:any)=>`<article class="staff-card"><strong>${escapeHtml(eventName(e.event_type))}</strong><span>${new Date(e.created_at+'Z').toLocaleString('it-IT')}</span></article>`).join('')||'<p class="muted">Nessuna operazione registrata.</p>';document.querySelectorAll<HTMLButtonElement>('[data-revoke-session]').forEach(b=>b.addEventListener('click',async()=>{if(!confirm('Chiudere questa sessione? Su quel dispositivo sarà necessario accedere nuovamente.'))return;try{await api(`auth/sessions/${b.dataset.revokeSession}`,{method:'DELETE'});await loadSecurity();}catch(err){if((err as any).message.includes('conferma nuovamente'))openReauth();else alert((err as Error).message);}}));};
const openReauth=()=>($<HTMLDialogElement>('[data-reauth-dialog]')).showModal();
const start2fa=async()=>{try{const d=await api('auth/totp/setup',{method:'POST',body:'{}'});$<HTMLElement>('[data-2fa-confirm]').hidden=false;$<HTMLElement>('[data-2fa-secret]').textContent=d.secret;await QRCode.toCanvas($<HTMLCanvasElement>('[data-2fa-qr]'),d.uri,{width:220,margin:1});$<HTMLElement>('[data-2fa-status]').textContent='Dopo aver inquadrato il QR, inserisci qui le 6 cifre mostrate dal telefono.';}catch(err){if((err as any).message.includes('conferma nuovamente'))openReauth();else $<HTMLElement>('[data-2fa-status]').textContent=(err as Error).message;}};
$<HTMLElement>('[data-start-2fa]').addEventListener('click',start2fa);$<HTMLElement>('[data-confirm-2fa]').addEventListener('click',async()=>{try{const d=await api('auth/totp/confirm',{method:'POST',body:JSON.stringify({code:($<HTMLInputElement>('[data-2fa-code]')).value})});$<HTMLElement>('[data-2fa-status]').textContent='Verifica in due passaggi attivata.';$<HTMLElement>('[data-recovery-codes]').textContent=d.recoveryCodes.join('\n');($<HTMLDialogElement>('[data-recovery-dialog]')).showModal();await loadSecurity();}catch(err){$<HTMLElement>('[data-2fa-status]').textContent=(err as Error).message;}});
$<HTMLFormElement>('[data-reauth-form]').addEventListener('submit',async e=>{e.preventDefault();const f=new FormData(e.currentTarget as HTMLFormElement);try{await api('auth/reauth',{method:'POST',body:JSON.stringify(Object.fromEntries(f))});($<HTMLDialogElement>('[data-reauth-dialog]')).close();(e.currentTarget as HTMLFormElement).reset();$<HTMLElement>('[data-reauth-status]').textContent='';}catch(err){$<HTMLElement>('[data-reauth-status]').textContent=(err as Error).message;}});$<HTMLElement>('[data-close-reauth]').addEventListener('click',()=>($<HTMLDialogElement>('[data-reauth-dialog]')).close());
const openAccount=(u:User|null)=>{selected=u;const f=$<HTMLFormElement>('[data-account-form]');f.hidden=false;f.reset();f.elements.namedItem('id')&&((f.elements.namedItem('id') as HTMLInputElement).value=u?.id||'');for(const k of ['name','email','username','role']){const el=f.elements.namedItem(k) as HTMLInputElement|HTMLSelectElement;if(el&&u)(el.value=(u as any)[k]);}$<HTMLElement>('[data-account-title]').textContent=u?u.name:'Nuovo account';$<HTMLElement>('[data-existing-actions]').hidden=!u||u.role==='owner';if(u&&u.role!=='owner')$<HTMLButtonElement>('[data-toggle-account]').textContent=u.active?'Disattiva account':'Riattiva account';};
$<HTMLFormElement>('[data-login-form]').addEventListener('submit',async e=>{e.preventDefault();const f=new FormData(e.currentTarget as HTMLFormElement);try{const data=await api('auth/login',{method:'POST',body:JSON.stringify(Object.fromEntries(f))});if(data.requiresTotp){$<HTMLElement>('[data-login-totp]').hidden=false;($<HTMLInputElement>('[data-login-totp] input')).required=true;$<HTMLElement>('[data-login-status]').textContent=data.error;return;}await start(data);}catch(err){const message=(err as Error).message;$<HTMLElement>('[data-login-status]').textContent=message;if(message.toLowerCase().includes('codice')){$<HTMLElement>('[data-login-totp]').hidden=false;($<HTMLInputElement>('[data-login-totp] input')).required=true;}}});
$<HTMLElement>('[data-forgot]').addEventListener('click',()=>{$<HTMLElement>('[data-login-form]').hidden=true;$<HTMLElement>('[data-reset-request]').hidden=false;});$<HTMLElement>('[data-back-login]').addEventListener('click',()=>{$<HTMLElement>('[data-login-form]').hidden=false;$<HTMLElement>('[data-reset-request]').hidden=true;});
$<HTMLFormElement>('[data-reset-request]').addEventListener('submit',async e=>{e.preventDefault();const f=new FormData(e.currentTarget as HTMLFormElement);try{await api('auth/reset-request',{method:'POST',body:JSON.stringify(Object.fromEntries(f))});$<HTMLElement>('[data-reset-status]').textContent='Se l’account è quello del proprietario, il collegamento è stato inviato all’email registrata.';}catch(err){$<HTMLElement>('[data-reset-status]').textContent=(err as Error).message;}});
$<HTMLFormElement>('[data-reset]').addEventListener('submit',async e=>{e.preventDefault();const token=new URLSearchParams(location.search).get('reset'),f=new FormData(e.currentTarget as HTMLFormElement);try{await api('auth/reset',{method:'POST',body:JSON.stringify({token,newPassword:f.get('newPassword')})});$<HTMLElement>('[data-reset-complete-status]').textContent='Password cambiata. Ora puoi accedere.';}catch(err){$<HTMLElement>('[data-reset-complete-status]').textContent=(err as Error).message;}});
$<HTMLElement>('[data-logout]').addEventListener('click',async()=>{await api('auth/logout',{method:'POST'});current=null;csrf='';showLogin();});
$<HTMLFormElement>('[data-owner-password]').addEventListener('submit',async e=>{e.preventDefault();const f=new FormData(e.currentTarget as HTMLFormElement);try{await api('auth/change-password',{method:'POST',body:JSON.stringify(Object.fromEntries(f))});current!.mustChange=false;(e.currentTarget as HTMLFormElement).reset();$<HTMLElement>('[data-password-status]').textContent='Password aggiornata.';showPanel('overview');await loadStats();}catch(err){$<HTMLElement>('[data-password-status]').textContent=(err as Error).message;}});
$<HTMLElement>('[data-new-account]').addEventListener('click',()=>openAccount(null));$<HTMLElement>('[data-cancel-account]').addEventListener('click',()=>{$<HTMLElement>('[data-account-form]').hidden=true;});
$<HTMLFormElement>('[data-account-form]').addEventListener('submit',async e=>{e.preventDefault();const f=new FormData(e.currentTarget as HTMLFormElement),payload=Object.fromEntries(f);try{if(selected){await api(`staff/${selected.id}`,{method:'PATCH',body:JSON.stringify({...payload,action:'update'})});}else{const d=await api('staff',{method:'POST',body:JSON.stringify(payload)});$<HTMLElement>('[data-temp-password]').textContent=d.temporaryPassword;($<HTMLDialogElement>('[data-password-dialog]')).showModal();}$<HTMLElement>('[data-account-form]').hidden=true;await loadUsers();}catch(err){$<HTMLElement>('[data-account-status]').textContent=(err as Error).message;}});
$<HTMLElement>('[data-set-password]').addEventListener('click',async()=>{if(!selected)return;const p=($<HTMLFormElement>('[data-account-form]').elements.namedItem('newPassword') as HTMLInputElement).value;if(!confirm(`Impostare una nuova password per ${selected.name}?`))return;await api(`staff/${selected.id}`,{method:'PATCH',body:JSON.stringify({action:'password',newPassword:p})});$<HTMLElement>('[data-account-status]').textContent='Nuova password impostata.';});
$<HTMLElement>('[data-toggle-account]').addEventListener('click',async()=>{if(!selected||!confirm(`${selected.active?'Disattivare':'Riattivare'} l’account di ${selected.name}?`))return;await api(`staff/${selected.id}`,{method:'PATCH',body:JSON.stringify({action:'toggle'})});$<HTMLElement>('[data-account-form]').hidden=true;await loadUsers();});
$<HTMLElement>('[data-delete-account]').addEventListener('click',async()=>{if(!selected||!confirm(`Cancellare definitivamente l’account di ${selected.name}?`))return;await api(`staff/${selected.id}`,{method:'DELETE'});$<HTMLElement>('[data-account-form]').hidden=true;await loadUsers();});
const resetToken=new URLSearchParams(location.search).get('reset');if(resetToken){$<HTMLElement>('[data-login-form]').hidden=true;$<HTMLElement>('[data-reset]').hidden=false;}else{api('auth/me').then(start).catch(showLogin);}
</script></body></html>
