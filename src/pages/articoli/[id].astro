---
import Card from '../../components/Card.astro';
import YouTubeVideo from '../../components/YouTubeVideo.astro';
import ArticleActions from '../../components/ArticleActions.astro';
import Comments from '../../components/Comments.astro';
import ContentTracker from '../../components/ContentTracker.astro';
import Base from '../../layouts/Base.astro';import {articles,categories} from '../../lib/content';import {render} from 'astro:content';
export async function getStaticPaths(){return (await articles()).map(article=>({params:{id:article.id},props:{article}}));}
const {article}=Astro.props;const visible=await articles();const related=visible.filter(a=>a.data.parent===article.id);const parent=visible.find(a=>a.id===article.data.parent);const {Content,headings}=await render(article);const minutes=Math.max(1,Math.ceil((article.body||'').split(/\s+/).length/200));
---
<Base title={`${article.data.title} — Retro di testa`} description={article.data.description} noindex={article.data.draft}><article class="wrap article"><a class="text-link" href="/articoli/">← Tutti gli articoli</a><header class="article-head"><p class="eyebrow">{categories[article.data.category]} / {article.data.tags.join(' · ')}</p><h1>{article.data.title}</h1><p class="lead">{article.data.description}</p><p class="muted">Di Marco Sala · <time datetime={article.data.date.toISOString()}>{article.data.date.toLocaleDateString('it-IT',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</time> · {minutes} min di lettura</p></header>{article.data.draft && <aside class="draft-notice"><strong>Anteprima privata · Articolo non pubblicato</strong><p>Questa anteprima è visibile solo in locale. La pubblicazione richiede l’approvazione dell’autore.</p></aside>}{article.data.image && <figure class="article-image"><img src={article.data.image} alt={article.data.imageAlt||''}/>{article.data.imageCaption && <figcaption>{article.data.imageCaption}</figcaption>}{article.data.image === '/immagini/server.svg' && <figcaption>Illustrazione editoriale, non fotografia di una prova.</figcaption>}</figure>}<div class="article-body"><aside class="toc"><strong>IN QUESTO ARTICOLO</strong><nav aria-label="Indice articolo">{headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}</nav></aside><div class="prose"><Content/></div></div>{related.length > 0 && <section class="question-section"><h2>Domande e curiosità.</h2><div class="cards">{related.map(item=><Card article={item}/>)}</div></section>}{parent && !(article.body || "").includes(`/articoli/${parent.id}/`) && <p class="parent-article"><a class="text-link" href={`/articoli/${parent.id}/`}>Da dove nasce questa domanda: {parent.data.title} →</a></p>}{article.data.youtube && <section class="article-youtube"><p class="eyebrow">L’ARGOMENTO, ANCHE IN VIDEO</p><h2>{article.data.youtube.title}</h2><YouTubeVideo id={article.data.youtube.id} title={article.data.youtube.title}/><p>Se il video ti è stato utile, puoi lasciarmi un commento o iscriverti al <a href="https://www.youtube.com/@RetrodiTesta" target="_blank" rel="noopener noreferrer">mio canale YouTube</a>.</p></section>}<ArticleActions id={article.id} title={article.data.title}/><Comments id={article.id} title={article.data.title} type="Articolo"/><div class="article-end"><strong>La prossima domanda?</strong><a class="text-link" href="/articoli/">Esplora gli articoli →</a></div><ContentTracker id={article.id} title={article.data.title} type="Articolo"/></article></Base>
