---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleActions from '../../components/ArticleActions.astro';
import Comments from '../../components/Comments.astro';
import ContentTracker from '../../components/ContentTracker.astro';

const entry = (await getCollection('articoli')).find(item => item.id === 'aurora-mtm-cassa-centrale-stampata-3d');
if (!entry) throw new Error('Progetto Aurora MTM non trovato');
const { Content, headings } = await render(entry);
---
<Base title={`${entry.data.title} — Progetti · Retro di testa`} description={entry.data.description}>
  <article class="wrap article project-article">
    <a class="text-link" href="/progetti/">← Tutti i progetti</a>
    <header class="article-head">
      <p class="eyebrow">SALA ACOUSTICS · PROGETTO AUDIO · STAMPA 3D</p>
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.description}</p>
      <p class="muted">Progettato e costruito da Marco Sala · Retro di testa</p>
    </header>
    {entry.data.image && <figure class="article-image"><img src={entry.data.image} alt={entry.data.imageAlt || ''}/>{entry.data.imageCaption && <figcaption>{entry.data.imageCaption}</figcaption>}</figure>}
    <div class="article-body">
      <aside class="toc"><strong>DENTRO IL PROGETTO</strong><nav aria-label="Indice del progetto">{headings.filter(h => h.depth === 2).map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</nav></aside>
      <div class="prose"><Content/></div>
    </div>
    <ArticleActions id={`progetto-${entry.id}`} title={entry.data.title}/>
    <Comments id={`progetto-${entry.id}`} title={entry.data.title} type="Progetto"/>
    <div class="article-end"><strong>Dal mio banco di lavoro</strong><a class="text-link" href="/progetti/">Esplora gli altri progetti →</a></div>
    <ContentTracker id={`progetto-${entry.id}`} title={entry.data.title} type="Progetto"/>
  </article>
</Base>
