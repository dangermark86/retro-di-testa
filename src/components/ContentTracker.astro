---
const { id, title, type = 'Articolo' } = Astro.props;
---
<script define:vars={{ id, title, type }}>
(() => {
  const send=(event,percent=0)=>fetch('/api/stats',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({contentId:id,contentTitle:title,contentType:type,event,percent}),keepalive:true}).catch(()=>{});
  send('view');
  let sent=false;
  const measure=()=>{if(sent)return;const total=document.documentElement.scrollHeight-innerHeight;if(total<=0)return;const percent=Math.round(Math.min(100,Math.max(0,scrollY/total*100)));if(percent>=90){sent=true;send('completion',percent);removeEventListener('scroll',measure);}};
  addEventListener('scroll',measure,{passive:true});
})();
</script>
