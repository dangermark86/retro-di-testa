---
import dossiers from '../lib/project-dossiers.json';
const {slug,name}=Astro.props;
type DossierPage={number:number;title:string;image:string;text:string;width:number;height:number;croppedImages?:{src:string;caption:string}[];webText?:string};
const pages:DossierPage[]=dossiers[slug as keyof typeof dossiers];
---
<section class="project-dossier" id="dossier"><header class="dossier-heading"><p class="eyebrow">COSTRUZIONE · ASCOLTO · MISURE</p><h2>Dentro {name}, dall’inizio alla fine.</h2><p>Qui raccolgo il dossier completo del progetto: tutti i passaggi documentati, le fotografie, le schede dei componenti e le schermate delle prove, con la loro spiegazione. Puoi scegliere un capitolo oppure leggere in ordine.</p></header><details class="dossier-index" open><summary>Indice completo · {pages.length} pagine</summary><nav aria-label={`Capitoli del dossier ${name}`}>{pages.map(page=><a href={`#dossier-${page.number}`}><span>{String(page.number).padStart(2,'0')}</span>{page.title}</a>)}</nav></details><div class="dossier-pages">{pages.map(page=><section class="dossier-chapter" id={`dossier-${page.number}`}><header><p class="eyebrow">DOSSIER / {String(page.number).padStart(2,'0')}</p><h3>{page.title}</h3><a href="#dossier">↑ Indice</a></header>{page.croppedImages ? <div class="dossier-cropped-content"><div class="component-crops">{page.croppedImages.map(pic=><figure><a href={pic.src} target="_blank" aria-label={`Ingrandisci: ${pic.caption}`}><img src={pic.src} alt={pic.caption} loading="lazy" decoding="async"/></a><figcaption>{pic.caption}</figcaption></figure>)}</div><div class="dossier-web-text">{page.webText}</div></div> : <figure><a href={page.image} target="_blank" aria-label={`Ingrandisci: ${page.title}`}><img src={page.image} alt={`${name}: ${page.title}. Pagina ${page.number} del dossier originale; testo accessibile disponibile sotto.`} width={page.width} height={page.height} loading="lazy" decoding="async"/></a><figcaption>Pagina {page.number} del mio dossier originale. Seleziona la pagina per ingrandire fotografie, tabelle e grafici.</figcaption></figure>}<details class="dossier-transcript"><summary>Leggi il testo di questa pagina</summary><div>{page.text}</div></details></section>)}</div></section>
