---
const { id, title, type = 'Pagina' } = Astro.props;
---
<script define:vars={{ id, title, type }}>
  (() => {
    fetch('/api/stats', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ contentId: id, contentTitle: title, contentType: type, event: 'view', percent: 0 }), keepalive: true }).catch(() => {});
  })();
</script>
